{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loom.local/schemas/decision.schema.json",
  "title": "Loom Decision Diagram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "start",
    "nodes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "const": "decision"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "label"
            ],
            "properties": {
              "type": {
                "const": "decision"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "yes": {
                "type": "string",
                "minLength": 1
              },
              "no": {
                "type": "string",
                "minLength": 1
              },
              "metadata": {
                "type": "object"
              },
              "group": {
                "type": "string",
                "minLength": 1
              },
              "branches": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "target",
                    "label"
                  ],
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "yes",
                  "no"
                ],
                "not": {
                  "required": [
                    "branches"
                  ]
                }
              },
              {
                "required": [
                  "branches"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "yes"
                      ]
                    },
                    {
                      "required": [
                        "no"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "label"
            ],
            "properties": {
              "type": {
                "const": "result"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "metadata": {
                "type": "object"
              },
              "group": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "samples": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "path"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "collapsed": {
            "type": "boolean"
          },
          "parent": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
